# This file is marked hidden on Windows, so an operator browsing the folder
# sees only the files they actually use -- the same reason .git is hidden.
#
# Windows refuses a truncating write to a hidden file, so to edit it:
#   attrib -h .gitignore   edit   attrib +h .gitignore
# git reads it either way; the attribute is invisible to it.

.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Runtime state: the bot's view of open positions and orders.
# Do not commit it, and do not delete it while positions are open.
app/state/*
!app/state/.gitkeep

# The private key. Read from BULK_PRIVATE_KEY, or from this file as a
# fallback. Never commit it.
private_key.local
.env

# settings.yaml is tracked and holds safe defaults. Personal variants
# (settings.mine.yaml, settings.prod.yaml) stay out of git.
settings.*.yaml
!settings.yaml
