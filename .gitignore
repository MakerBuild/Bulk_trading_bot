# This file is marked hidden on Windows, so an operator browsing the folder
# sees only the files they actually use -- the same reason .git is hidden.
#
# Windows refuses a truncating write to a hidden file, so to edit it:
#   attrib -h .gitignore   edit   attrib +h .gitignore
# git reads it either way; the attribute is invisible to it.

.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Runtime state: the bot's view of open positions and orders.
# Do not commit it, and do not delete it while positions are open.
app/state/*
!app/state/.gitkeep

# The private key. Read from BULK_PRIVATE_KEY, or from this file as a
# fallback. Never commit it.
private_key.local
# Copies of it under another name. Notepad's "Save As" adds .txt, and a
# backup gets .bak or .old -- each a key file git would otherwise offer to
# commit with `git add -A`.
private_key.local.*
# The keystore writes the encrypted envelope to a uniquely named temp file
# beside the key -- .private_key.local.<random>.tmp -- and renames it over
# the key file, so for a moment, or for good if the write is interrupted,
# that file holds the key. Nothing that ends in .tmp is ever meant to be
# committed.
*.tmp
.*.tmp

# The proxy address, for operators where BULK is blocked. Belongs here for the
# same reason as the key: install.bat creates it, and the line an operator puts
# in it usually carries a password.
proxy.local
proxy.local.*
.env

# The operator's own settings. `app/settings.default.yaml` is what ships; the
# installer copies it to `settings.yaml` in the root on first run, and that copy
# is theirs to edit. Tracking it would mean a merge conflict on every update for
# anyone who had changed a size.
settings.yaml
settings.*.yaml
settings.yaml.*
!app/settings.default.yaml

# The log file, and the two rollovers the handler keeps. Written into the
# folder the operator has open so it is easy to find and easy to send; never
# committed, because it is a record of one machine's runs.
logs.txt
logs.txt.*

# The name this file had before. Someone who ran an older build still has one
# sitting in their folder, and it must not be committed just because it was
# renamed.
ЛОГИ.txt
ЛОГИ.txt.*

# Release zips, built by app/dev/release.bat. Handed out, never committed.
dist/
