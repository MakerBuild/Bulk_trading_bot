.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Runtime state. Contains the bot's view of open positions and orders --
# do not commit it, and do not delete it while positions are open.
state/*
!state/.gitkeep
*.state.json

# config.yaml is tracked and holds placeholders only -- the private key never
# goes in it. Local variants (config.mine.yaml, config.prod.yaml) stay ignored.
config.*.yaml
.env

# The private key: read from BULK_PRIVATE_KEY, or from this local file as a
# fallback. Never commit it.
private_key.local
